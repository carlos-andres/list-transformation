{
  "name": "list-transformation",
  "publisher": "calo",
  "displayName": "List Transformation",
  "description": "List Transformation commands tailored for developers working with lists of strings, especially in the context of preparing data for databases or data processing scripts.",
  "version": "0.7.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "list",
    "lines",
    "csv",
    "comma separated",
    "sort",
    "duplicates",
    "sql",
    "like"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.orderAndCleanList",
        "title": "LIST: Order and Clean List"
      },
      {
        "command": "extension.toCommaSeparated",
        "title": "LIST: Convert to Comma Separated Values"
      },
      {
        "command": "extension.toQuotedCommaSeparated",
        "title": "LIST: Convert to Quoted Comma Separated Values"
      },
      {
        "command": "extension.fromCommaSeparatedToLines",
        "title": "LIST: Convert Comma Separated Values to Lines"
      },
      {
        "command": "extension.listToSqlLike",
        "title": "LIST: Convert List to SQL LIKE Clauses"
      },
      {
        "command": "extension.removeDuplicatesOnList",
        "title": "LIST: Remove Duplicates"
      },
      {
        "command": "extension.restoreOriginalList",
        "title": "LIST: Restore Original List"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "listTransformation",
          "title": "List",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "listTransformation": [
        {
          "type": "webview",
          "id": "listTransformation.panel",
          "name": "Transformations",
          "when": "config.listTransformation.panel.enabled"
        }
      ]
    },
    "configuration": {
      "title": "List Transformation",
      "properties": {
        "listTransformation.panel.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the List pane. It opens from the List icon in the activity bar."
        },
        "listTransformation.panel.numberKeys": {
          "type": "boolean",
          "default": true,
          "description": "Run a transformation by pressing its number (1–6) while the List pane has focus."
        },
        "listTransformation.removeDuplicates.showSummary": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "After Remove Duplicates, show a message with the number of duplicates removed and unique values left. The Enable duplicate notifications checkbox in the List pane changes this setting too."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-andres/list-transformation"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --max-warnings 0",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "eslint": "10.14.0",
    "mocha": "12.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@12.18.0"
}
